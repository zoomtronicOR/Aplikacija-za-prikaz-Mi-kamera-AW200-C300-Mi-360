[Unit]
Description=Xiaomi Camera Hub: reconnect camera sources in go2rtc on request (ESP32 resolution)
After=network.target docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/xiaomi-cam-hub/scripts/streamctl.py
Restart=always
RestartSec=10
DynamicUser=no

[Install]
WantedBy=multi-user.target
